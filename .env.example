JWT_SECRET=

# Payment service
PAYMENT_GRPC_PORT=50052
# HTTP port, only for the Stripe callback (/callbacks/stripe)
PAYMENT_HTTP_PORT=3002
PAYMENT_DB_PORT=27018
MONGO_PAYMENT_URL=mongodb://localhost:27018
# Stripe test mode (dashboard.stripe.com, Developers > API keys): put your own
# sk_test_ key in .env only. The webhook secret (whsec_) is printed by
# `stripe listen --forward-to localhost:3002/callbacks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Kiosk pages Stripe redirects the customer to after the payment page
PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel
# Lifetime of an unpaid Stripe Checkout page (30 minimum)
PAYMENT_CHECKOUT_TTL_MINUTES=30
